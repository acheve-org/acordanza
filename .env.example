# Used by docker-compose.yml for the local Postgres container.
# Copy to .env and adjust if you don't want the defaults.

# Mandatory (no defaults)
JWT_KEY=CHANGE_ME_replace_with_a_long_random_secret

# Optional (safe defaults)
POSTGRES_DB=acordanza
POSTGRES_USER=acordanza
POSTGRES_PASSWORD=acordanza
POSTGRES_PORT=5432
BACKEND_PORT=1234
FRONTEND_URL=http://localhost:5173
