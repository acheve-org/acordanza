{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=acordanza;Username=acordanza;Password=acordanza"
  },
  "Jwt": {
    "Issuer": "Acordanza.Api",
    "Audience": "Acordanza.Client",
    "ExpiryMinutes": 43200
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Fido2": {
    "ServerDomain": "localhost",
    "ServerName": "Acordanza"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Resend": {
    "FromEmail": "noreply@acordanza.eu",
    "FromName": "Acordanza"
  },
  "Storage": {
    "ContainerName": "topos",
    "DataProtectionContainerName": "dataprotection-keys",
    "EnrichmentQueueName": "route-enrichment",
    "RouteImportQueueName": "route-import"
  },
  "Invites": {
    "MaxForUser": 5,
    "MaxForModerator": 10
  }
}
