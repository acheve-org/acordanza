{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "bun run --cwd ../design-system build",
    "dev": "vite",
    "prebuild": "bun run --cwd ../design-system build",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pretest": "bun run --cwd ../design-system build",
    "test": "vitest run",
    "pretest:watch": "bun run --cwd ../design-system build",
    "test:watch": "vitest",
    "generate-api": "bunx openapi-typescript@7.13.0 ../backend/Acordanza.Api/openapi/Acordanza.Api.json -o src/api/generated.ts"
  },
  "dependencies": {
    "@github/webauthn-json": "^2.1.1",
    "@tanstack/react-query": "^5.101.4",
    "acordanza-design-system": "workspace:*",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "4"
  }
}
